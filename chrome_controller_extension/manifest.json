{
  "name": "Chrome Controller",
  "description": "Extension for Chrome Controller",
  "version": "1.0",
  "manifest_version": 3,
  "action": {
    "default_popup": "hello.html",
    "default_icon": "hello_extensions.png"
  },
  "permissions": [
    "tabs",
    "scripting",
    "activeTab",
    "offscreen",
    "alarms",
    "system.display"
  ],
  "host_permissions": [
    "http://localhost:3000/*",
    "https://www.netflix.com/*",
    "https://www.youtube.com/tv",
    "https://www.primevideo.com/*",
    "https://www.twitch.tv/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}